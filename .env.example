# Artalk: server-only. PostgreSQL connection string, separate from Guestbook.
ATK_DB_DSN=
ATK_SITE_URL=
ATK_APP_KEY=
ATK_CAPTCHA_TURNSTILE_SITE_KEY=
ATK_CAPTCHA_TURNSTILE_SECRET_KEY=
# Owner-only GitHub OAuth. Callback: <origin>/api/v2/auth/github/callback
# Numeric GitHub account ID, not its username. Visitors remain anonymous.
ARTALK_GITHUB_OWNER_ID=
ATK_AUTH_GITHUB_CLIENT_ID=
ATK_AUTH_GITHUB_CLIENT_SECRET=
# Optional Gmail notifications.
ATK_EMAIL_ENABLED=false
ATK_EMAIL_SEND_ADDR=
ATK_EMAIL_SMTP_USERNAME=
ATK_EMAIL_SMTP_PASSWORD=
# Optional blocked phrases, one per line. Matching comments remain pending.
ARTALK_BLOCKED_WORDS=

# Guestbook: server-only. Use a dedicated Neon database; apply db/guestbook.sql first.
GUESTBOOK_DATABASE_URL=
# Exact website origin, no trailing path. Also used to verify the shared Artalk owner session.
GUESTBOOK_ORIGIN=
# Random secret of at least 32 characters for IP hashing.
GUESTBOOK_SESSION_SECRET=
# Management shares the Artalk owner OAuth configuration above.
# Optional owner notifications: messages remain saved if mail is unavailable.
GUESTBOOK_GMAIL_USER=
GUESTBOOK_GMAIL_APP_PASSWORD=

# Cloudflare Turnstile: public site key and server-only secret. Required for submissions.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
GUESTBOOK_TURNSTILE_SECRET_KEY=
