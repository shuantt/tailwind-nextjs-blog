{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": ".",
      "framework": "nextjs",
      "installCommand": "node .yarn/releases/yarn-3.6.1.cjs install --immutable",
      "buildCommand": "node .yarn/releases/yarn-3.6.1.cjs build"
    },
    "artalk": {
      "root": "services/artalk",
      "framework": "go",
      "installCommand": "node build.mjs --prepare",
      "buildCommand": "node build.mjs"
    }
  },
  "redirects": [{ "source": "/sidebar/", "destination": "/sidebar", "permanent": false }],
  "rewrites": [
    { "source": "/api/v2/:path*", "destination": { "service": "artalk" } },
    { "source": "/dist/:path*", "destination": { "service": "artalk" } },
    { "source": "/sidebar/:path*", "destination": { "service": "artalk" } },
    { "source": "/comment-images/:path*", "destination": { "service": "artalk" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
